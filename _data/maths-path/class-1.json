{
  "id": "class-1",
  "label": "Class 1",
  "name": "Class 1",
  "ages": "Ages 5 to 6",
  "blurb": "Numbers to 100, adding, shapes, time and money.",
  "live": true,
  "grade": "class-1",
  "chapters": [
    {
      "id": "numbers",
      "title": "Tens, ones and number names",
      "tagline": "Build any number up to 100 from tens and ones.",
      "outcomes": [
        "I can build a number with tens and ones.",
        "I can match a number to its name.",
        "I can compare and order two-digit numbers."
      ],
      "vocab": [
        {
          "term": "ones",
          "meaning": "Single small cubes. Ten ones make one ten."
        },
        {
          "term": "tens",
          "meaning": "A stick of ten cubes joined together."
        },
        {
          "term": "digit",
          "meaning": "One of the symbols 0 to 9 used to write numbers."
        }
      ],
      "see": [
        {
          "title": "Ten ones make one ten",
          "art": "think",
          "text": [
            "One small cube is one 'one'.",
            "Ten ones stuck together make a long stick. We call it one 'ten'."
          ],
          "widget": {
            "w": "placeValue",
            "c": {
              "tens": 1,
              "ones": 0
            }
          }
        },
        {
          "title": "Read a two-digit number",
          "art": "happy",
          "text": [
            "The number 34 has two digits.",
            "The first digit, 3, tells us the tens. The second digit, 4, tells us the ones.",
            "So 34 is 3 tens and 4 ones."
          ],
          "widget": {
            "w": "placeValue",
            "c": {
              "tens": 3,
              "ones": 4
            }
          }
        },
        {
          "title": "Say the number name",
          "art": "think",
          "text": [
            "Tens have special names: ten, twenty, thirty, forty, fifty.",
            "34 is said 'thirty-four'. Say the tens name, then the ones name."
          ],
          "widget": {
            "w": "numberLine",
            "c": {
              "min": 30,
              "max": 40,
              "marker": 34,
              "labelEvery": 1
            }
          }
        },
        {
          "title": "Which number is bigger?",
          "art": "cheer",
          "text": [
            "Look at the tens first. More tens means a bigger number.",
            "If the tens are the same, look at the ones.",
            "47 is bigger than 38 because 4 tens is more than 3 tens."
          ],
          "widget": {
            "w": "placeValue",
            "c": {
              "tens": 4,
              "ones": 7
            }
          }
        }
      ],
      "try": [
        {
          "prompt": "Build the number 34. Use the buttons to add tens and ones.",
          "widget": {
            "w": "placeValue",
            "c": {
              "tens": 0,
              "ones": 0
            }
          },
          "target": {
            "tens": 3,
            "ones": 4
          },
          "success": "34 is 3 tens and 4 ones.",
          "hint": "Add 3 tens first. Then add 4 ones."
        },
        {
          "prompt": "Move the marker to 27 on the number line.",
          "widget": {
            "w": "numberLine",
            "c": {
              "min": 20,
              "max": 30,
              "start": 20,
              "labelEvery": 1
            }
          },
          "target": {
            "position": 27
          },
          "success": "27 is between 20 and 30, closer to 30.",
          "hint": "27 is 7 steps after 20."
        }
      ],
      "play": {
        "game": "space-academy"
      },
      "tools": []
    },
    {
      "id": "operations",
      "title": "Add, subtract and find the missing part",
      "tagline": "Join groups, take some away and find a part that is hiding.",
      "outcomes": [
        "I can solve an add or take-away story.",
        "I can find a missing part.",
        "I can check related number facts."
      ],
      "vocab": [
        {
          "term": "add",
          "meaning": "Put groups together to find how many altogether."
        },
        {
          "term": "take away",
          "meaning": "Remove some to find how many are left."
        },
        {
          "term": "part and whole",
          "meaning": "The small groups are the parts. All of them together is the whole."
        }
      ],
      "see": [
        {
          "title": "Adding means joining",
          "art": "think",
          "text": [
            "You have 6 counters. A friend gives you 3 more.",
            "Count them all: 9 counters. We write 6 + 3 = 9."
          ],
          "widget": {
            "w": "tenFrame",
            "c": {
              "count": 6,
              "second": 3
            }
          }
        },
        {
          "title": "Taking away means fewer",
          "art": "happy",
          "text": [
            "There are 9 counters. 4 go away.",
            "Count what is left: 5. We write 9 − 4 = 5."
          ],
          "widget": {
            "w": "tenFrame",
            "c": {
              "count": 5
            }
          }
        },
        {
          "title": "Parts and a whole",
          "art": "think",
          "text": [
            "A bar shows the whole on top and the parts below.",
            "The parts 7 and 5 make a whole of 12."
          ],
          "widget": {
            "w": "barModel",
            "c": {
              "parts": [
                7,
                5
              ]
            }
          }
        },
        {
          "title": "Find the hidden part",
          "art": "cheer",
          "text": [
            "The whole is 12. One part is 7. The other part is hiding.",
            "Take away to find it: 12 − 7 = 5. The hidden part is 5."
          ],
          "widget": {
            "w": "barModel",
            "c": {
              "parts": [
                7,
                5
              ],
              "unknown": "b"
            }
          }
        }
      ],
      "try": [
        {
          "prompt": "Show 6 + 3. Tap the boxes until the frame holds all 9 counters.",
          "widget": {
            "w": "tenFrame",
            "c": {
              "start": 0
            }
          },
          "target": {
            "count": 9
          },
          "success": "6 and 3 make 9.",
          "hint": "Start with 6 counters, then add 3 more."
        },
        {
          "prompt": "Make two parts that make 12. Use the plus and minus buttons.",
          "widget": {
            "w": "barModel",
            "c": {
              "a": 0,
              "b": 0,
              "max": 12
            }
          },
          "target": {
            "total": 12
          },
          "success": "Two parts can make 12 in many ways.",
          "hint": "Try 6 and 6, or 7 and 5."
        },
        {
          "prompt": "The left side has 5. Add to the left side until the balance is level with 9 on the right.",
          "widget": {
            "w": "balance",
            "c": {
              "left": 5,
              "right": 9,
              "max": 12
            }
          },
          "target": {
            "added": 4
          },
          "success": "5 + 4 = 9. Both sides are equal.",
          "hint": "How many more does 5 need to reach 9?"
        }
      ],
      "play": {
        "game": "space-academy"
      },
      "tools": []
    },
    {
      "id": "patterns",
      "title": "Picture and number patterns",
      "tagline": "Spot what repeats and what comes next.",
      "outcomes": [
        "I can fill a missing picture.",
        "I can continue a growing pattern.",
        "I can find a missing number or letter."
      ],
      "vocab": [
        {
          "term": "pattern",
          "meaning": "Something that repeats in the same order."
        },
        {
          "term": "repeat unit",
          "meaning": "The small piece that comes round again and again."
        },
        {
          "term": "skip counting",
          "meaning": "Counting in jumps, like 2, 4, 6, 8."
        }
      ],
      "see": [
        {
          "title": "A pattern repeats",
          "art": "think",
          "text": [
            "Red, blue, red, blue, red, blue.",
            "The piece 'red, blue' keeps coming round. That piece is the repeat unit."
          ],
          "widget": {
            "w": "patternBuilder",
            "c": {
              "palette": [
                {
                  "id": "r",
                  "label": "red",
                  "color": "#ef6b5b",
                  "icon": "●"
                },
                {
                  "id": "b",
                  "label": "blue",
                  "color": "#4aa8ff",
                  "icon": "●"
                }
              ],
              "sequence": [
                "r",
                "b",
                "r",
                "b",
                "r",
                "b"
              ]
            }
          }
        },
        {
          "title": "Find the missing piece",
          "art": "happy",
          "text": [
            "Say the pattern from the start. Listen for where it repeats.",
            "Red, blue, red, ... The next one must be blue."
          ],
          "widget": {
            "w": "patternBuilder",
            "c": {
              "palette": [
                {
                  "id": "r",
                  "label": "red",
                  "color": "#ef6b5b",
                  "icon": "●"
                },
                {
                  "id": "b",
                  "label": "blue",
                  "color": "#4aa8ff",
                  "icon": "●"
                }
              ],
              "sequence": [
                "r",
                "b",
                "r",
                null,
                "r",
                "b"
              ],
              "caption": "The gap is blue."
            }
          }
        },
        {
          "title": "Number patterns jump",
          "art": "think",
          "text": [
            "2, 4, 6, 8 ... Each number is 2 more than the one before.",
            "That is skip counting by twos. The next number is 10."
          ],
          "widget": {
            "w": "numberLine",
            "c": {
              "min": 0,
              "max": 10,
              "hops": [
                [
                  0,
                  2
                ],
                [
                  2,
                  4
                ],
                [
                  4,
                  6
                ],
                [
                  6,
                  8
                ],
                [
                  8,
                  10
                ]
              ],
              "labelEvery": 2
            }
          }
        },
        {
          "title": "Patterns that grow",
          "art": "cheer",
          "text": [
            "A growing pattern gets bigger each time.",
            "1 counter, then 2, then 3, then 4. Each step adds one more."
          ],
          "widget": {
            "w": "tenFrame",
            "c": {
              "count": 4
            }
          }
        }
      ],
      "try": [
        {
          "prompt": "Finish the pattern. Tap the gap, then tap a tile.",
          "widget": {
            "w": "patternBuilder",
            "c": {
              "palette": [
                {
                  "id": "r",
                  "label": "red",
                  "color": "#ef6b5b",
                  "icon": "●"
                },
                {
                  "id": "b",
                  "label": "blue",
                  "color": "#4aa8ff",
                  "icon": "●"
                },
                {
                  "id": "y",
                  "label": "yellow",
                  "color": "#f4c542",
                  "icon": "●"
                }
              ],
              "sequence": [
                "r",
                "b",
                "y",
                "r",
                null,
                "y",
                "r",
                null
              ],
              "answer": [
                "b",
                "b"
              ]
            }
          },
          "target": {},
          "success": "The repeat unit is red, blue, yellow.",
          "hint": "Say it: red, blue, yellow, red, ... again."
        }
      ],
      "play": {
        "game": "space-academy"
      },
      "tools": []
    },
