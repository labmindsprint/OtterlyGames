    {
      "id": "time",
      "title": "Read clocks and calendars",
      "tagline": "Read the hands, then talk about days and months.",
      "outcomes": [
        "I can read a clock.",
        "I can find a later time.",
        "I can find a day or month."
      ],
      "vocab": [
        {
          "term": "hour hand",
          "meaning": "The short hand. It tells the hour."
        },
        {
          "term": "minute hand",
          "meaning": "The long hand. It tells the minutes."
        },
        {
          "term": "o'clock",
          "meaning": "The minute hand points straight up at 12."
        }
      ],
      "see": [
        {
          "title": "Two hands, two jobs",
          "art": "think",
          "text": [
            "The short hand is the hour hand.",
            "The long hand is the minute hand.",
            "Look at the short hand first."
          ],
          "widget": {
            "w": "clock",
            "c": {
              "hour": 3,
              "minute": 0
            }
          }
        },
        {
          "title": "O'clock",
          "art": "happy",
          "text": [
            "When the long hand points to 12, it is an o'clock time.",
            "The short hand points to 3. So it is 3 o'clock."
          ],
          "widget": {
            "w": "clock",
            "c": {
              "hour": 3,
              "minute": 0
            }
          }
        },
        {
          "title": "Half past",
          "art": "cheer",
          "text": [
            "When the long hand points to 6, half an hour has passed.",
            "The short hand is between 7 and 8. We say half past 7."
          ],
          "widget": {
            "w": "clock",
            "c": {
              "hour": 7,
              "minute": 30
            }
          }
        },
        {
          "title": "Days and months",
          "art": "think",
          "text": [
            "A week has 7 days. A year has 12 months.",
            "After Saturday comes Sunday, and a new week starts."
