    {
      "id": "measurement",
      "title": "Measure length and weight",
      "tagline": "Compare fairly and measure with equal units.",
      "outcomes": [
        "I can measure with equal units.",
        "I can compare weights.",
        "I can choose a sensible unit."
      ],
      "vocab": [
        {
          "term": "unit",
          "meaning": "A fixed size we count with, like a paper clip or a cube."
        },
        {
          "term": "length",
          "meaning": "How long something is from end to end."
        },
        {
          "term": "heavier",
          "meaning": "Pushes down harder on a balance."
        }
      ],
      "see": [
        {
          "title": "Start at zero",
          "art": "think",
          "text": [
            "To measure length, put one end at zero.",
            "Read the number at the other end. This pencil is 6 units long."
          ],
          "widget": {
            "w": "numberLine",
            "c": {
              "min": 0,
              "max": 10,
              "hops": [
                [
                  0,
                  6
                ]
              ],
              "marker": 6
            }
          }
        },
        {
          "title": "Units must be equal",
          "art": "happy",
          "text": [
            "Count with units that are all the same size.",
            "If the units are different sizes, the answer is not fair."
          ],
          "widget": {
            "w": "numberLine",
            "c": {
              "min": 0,
              "max": 8,
              "hops": [
                [
                  0,
                  8
                ]
              ],
              "caption": "8 equal cubes."
            }
          }
        },
        {
          "title": "Weigh on a balance",
          "art": "cheer",
          "text": [
            "The heavier side goes down.",
            "When both sides weigh the same, the balance is level."
          ],
          "widget": {
            "w": "balance",
            "c": {
              "left": 3,
              "right": 6
            }
          }
        }
      ],
      "try": [
